<odoo>
    <record id="view_popup_image_form" model="ir.ui.view">
        <field name="name">website.popup.image.form</field>
        <field name="model">website.popup.image</field>
        <field name="arch" type="xml">
            <form string="Website Popup Image">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="image"/>
                        <field name="website_ids" widget="many2many_tags"/>
                        <field name="button_text"/>
                        <field name="button_link"/>
                        <field name="page_urls"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_popup_image_tree" model="ir.ui.view">
        <field name="name">website.popup.image.tree</field>
        <field name="model">website.popup.image</field>
        <field name="arch" type="xml">
            <tree string="Website Popup Images">
                <field name="name"/>
                <field name="website_ids"/>
                <field name="button_text"/>
                <field name="button_link"/>
                <field name="page_urls"/>
            </tree>
        </field>
    </record>
    <!-- Action associated with the sub-menu -->
    <record id="action_popup_image" model="ir.actions.act_window">
        <field name="name">Popup Images</field>
        <field name="res_model">website.popup.image</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_popup_image_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first popup image
            </p>
        </field>
    </record>
    <!-- Parent menu item under Website -->
    <menuitem id="menu_website_popup_root"
              name="Website Popup"
              parent="website.menu_website_configuration"
              sequence="50"
              groups="group_website_popup_manager"/>

    <!-- Sub-menu for Popup Images -->
    <menuitem id="menu_website_popup_image"
              name="Manage Popup Images"
              parent="menu_website_popup_root"
              action="action_popup_image"
              sequence="10"
              groups="group_website_popup_manager"/>
    
</odoo>
