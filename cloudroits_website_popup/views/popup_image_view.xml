<odoo>
    <record id="view_popup_image_form" model="ir.ui.view">
        <field name="name">website.popup.image.form</field>
        <field name="model">website.popup.image</field>
        <field name="arch" type="xml">
            <form string="Website Popup Image">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="image"/>
                        <field name="website_ids" widget="many2many_tags"/>
                        <field name="button_text"/>
                        <field name="button_link"/>
                        <field name="page_urls"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_popup_image_tree" model="ir.ui.view">
        <field name="name">website.popup.image.tree</field>
        <field name="model">website.popup.image</field>
        <field name="arch" type="xml">
            <tree string="Website Popup Images">
                <field name="name"/>
                <field name="website_ids"/>
                <field name="button_text"/>
                <field name="button_link"/>
                <field name="page_urls"/>
            </tree>
        </field>
    </record>
    <record id="action_website_popup_image" model="ir.actions.act_window">
        <field name="name">Popup Images</field>
        <field name="res_model">website.popup.image</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_website_popup_image" name="Popup Image"
              parent="website.menu_website_configuration"
              action="action_website_popup_image"/>

    
</odoo>
