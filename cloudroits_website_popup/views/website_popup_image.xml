<odoo>
    

    <template id="homepage_popup_image" inherit_id="website.layout" name="Homepage Popup Image">
    <!-- Set the popup_image variable by querying the website.popup.image model -->
        
         <!-- Embed JavaScript directly to set page URLs -->
        <xpath expr="//head" position="inside">
        <t t-set="popup_image" t-value="request.env['website.popup.image'].sudo().search([
            ('website_ids', 'in', [website.id])], limit=1)"/>
            <script type="text/javascript">
                var popupPageUrls = "<t t-esc="popup_image.page_urls or ''"/>";
            </script>
        </xpath>

        
        <xpath expr="//body" position="inside">
        <t t-set="popup_image" t-value="request.env['website.popup.image'].sudo().search([
            ('website_ids', 'in', [website.id])], limit=1)"/>
      
            <t t-if="popup_image and popup_image.image">
                <div id="cloudroits-popup-modal" class="cloudroits-modal" style="display:none;">
                    <div class="cloudroits-modal-content">
                        <span class="cloudroits-close">×</span>
                        <img t-attf-src="/web/image/website.popup.image/{{popup_image.id}}/image" alt="Popup Image"/>
                        <t t-if="popup_image.button_text and popup_image.button_link">
                            <a t-att-href="popup_image.button_link" class="cloudroits-popup-button">
                                <t t-esc="popup_image.button_text"/>
                            </a>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>